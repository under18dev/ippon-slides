---
// トップページ。Starlight のページとして描き（ヘッダー・検索・テーマ切り替えをドキュメントと共有）、
// ヒーローは components/Hero.astro（Starlight の Hero を置き換え）、本文は機能のカード
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import Features from '../../components/Features.astro'
import { COPY } from '../../landing'

const t = COPY.ja
---

<StarlightPage
  frontmatter={{
    title: t.title,
    description: t.description,
    template: 'splash',
    hero: { title: t.title },
    pagefind: false,
  }}
>
  <Features lang="ja" />
</StarlightPage>
