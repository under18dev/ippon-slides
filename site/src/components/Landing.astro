---
// トップページ（英語 / 日本語共通）。文言は src/landing.ts。
// デモは site/demo/<lang>.md を ippon で実際にビルドしたデッキ（public/demo/<lang>/）を iframe で埋め込み、
// 左にスライドごとの Markdown を並べて、表示中のスライドと連動させる。
import { slideLines } from '../../../dist/markdown.js'
import { COPY, docsPath, type Lang } from '../landing'
import '../styles/landing.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = COPY[lang]
const SITE = 'https://ippon.under18.dev'

// デモの Markdown をスライドごとに切り出す（ippon と同じ区切り方。frontmatter は除く）
const sources = import.meta.glob<string>('../../demo/*.md', { query: '?raw', import: 'default', eager: true })
const md = sources[`../../demo/${lang}.md`]!
const lines = md.split('\n')
const slides = (slideLines(md) as [number, number][]).map(([a, b]) => lines.slice(a - 1, b).join('\n'))

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
// Markdown の見た目を少しだけ色分けする（指示・見出し・強調・コード）
const mdHtml = (src: string) => {
  let inFence = false
  return src
    .split('\n')
    .map((line) => {
      const e = esc(line)
      if (/^```/.test(line)) {
        inFence = !inFence
        return `<span class="m-fence">${e}</span>`
      }
      if (inFence) return `<span class="m-code">${e}</span>`
      if (/^::.*::\s*$/.test(line)) return `<span class="m-dir">${e}</span>`
      if (/^#{1,3} /.test(line)) return `<span class="m-h">${e}</span>`
      if (/^-# /.test(line)) return `<span class="m-note">${e}</span>`
      return e.replace(/\*\*(.+?)\*\*/g, '<span class="m-b">**$1**</span>').replace(/`([^`]+)`/g, '<span class="m-c">`$1`</span>')
    })
    .join('\n')
}

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'ippon-slides',
      alternateName: 'ippon',
      description: t.description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows (Node.js ≥ 18.17)',
      url: SITE + t.path,
      downloadUrl: 'https://www.npmjs.com/package/ippon-slides',
      codeRepository: 'https://github.com/under18dev/ippon-slides',
      license: 'https://opensource.org/licenses/MIT',
      author: { '@type': 'Person', name: 'tanahiro2010' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: lang === 'ja' ? 'JPY' : 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a.replace(/<[^>]+>/g, '') },
      })),
    },
  ],
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={SITE + t.path} />
    <link rel="alternate" hreflang="en" href={`${SITE}/`} />
    <link rel="alternate" hreflang="ja" href={`${SITE}/ja/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ippon-slides" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={SITE + t.path} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class="landing">
    <header class="nav">
      <div class="wrap">
        <a class="brand" href={t.path}>ippon<span class="dot">.</span></a>
        <nav>
          <a href={docsPath(lang)}>{t.nav.docs}</a>
          <a class="hide-sm" href="https://github.com/under18dev/ippon-slides">GitHub</a>
          <a class="hide-sm" href="https://www.npmjs.com/package/ippon-slides">npm</a>
          <a class="lang" href={t.other.path} hreflang={lang === 'ja' ? 'en' : 'ja'}>{t.other.label}</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <h1>{t.hero.title[0]}<br />{t.hero.title[1]}</h1>
          <p class="lede">{t.hero.lede}</p>
          <div class="cta">
            <a class="btn primary" href={docsPath(lang, 'getting-started')}>{t.hero.start}</a>
            <a class="btn" href="https://github.com/under18dev/ippon-slides">{t.hero.star}</a>
            <span class="copybar">
              <code>npx ippon-slides init</code>
              <button type="button" data-copy="npx ippon-slides init" data-done={t.hero.copied}>{t.hero.copy}</button>
            </span>
          </div>
        </div>
      </section>

      <section class="demo" id="demo">
        <div class="wrap">
          <h2>{t.demo.title}</h2>
          <p class="sub">{t.demo.sub}</p>
          <div class="demo-grid">
            <div class="pane src">
              <div class="pane-bar"><span>{t.demo.source}</span></div>
              <ol class="chunks">
                {
                  slides.map((s, i) => (
                    <li>
                      <button type="button" data-slide={i + 1} aria-label={`${i + 1}`}>
                        <pre set:html={mdHtml(s)} />
                      </button>
                    </li>
                  ))
                }
              </ol>
            </div>
            <div class="pane deck">
              <div class="pane-bar">
                <span>{t.demo.deck}</span>
                <span class="ctrl">
                  <button type="button" data-step="-1" aria-label={t.demo.prev}>←</button>
                  <span class="count"><span data-cur>1</span> / {slides.length}</span>
                  <button type="button" data-step="1" aria-label={t.demo.next}>→</button>
                </span>
              </div>
              <div class="frame">
                <iframe id="demo-frame" src={`/demo/${lang}/`} title={t.demo.deck} loading="lazy"></iframe>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="why">
        <div class="wrap cols">
          <div>
            <h2>{t.why.title}</h2>
            <p class="sub" set:html={t.why.body} />
          </div>
          <div>
            <p class="lead-quote">{t.why.quote}</p>
            <p class="muted">{t.why.note}</p>
          </div>
        </div>
      </section>

      <section id="features">
        <div class="wrap">
          <h2>{t.features.title}</h2>
          <p class="sub">{t.features.sub}</p>
          <div class="grid">
            {
              t.features.items.map(([h, p]) => (
                <div class="item">
                  <h3>{h}</h3>
                  <p set:html={p} />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="quickstart">
        <div class="wrap">
          <h2>{t.quick.title}</h2>
          <p class="sub" set:html={t.quick.sub} />
          <div class="cols">
            {
              t.quick.steps.map((s, i) => (
                <div class="step">
                  <h3>
                    <span class="n">{String(i + 1).padStart(2, '0')}</span>
                    {s.title}
                  </h3>
                  <pre set:html={esc(s.code).replace(/^(#.*)$/gm, '<span class="c">$1</span>')} />
                </div>
              ))
            }
          </div>
          <p><a class="more" href={docsPath(lang, 'getting-started')}>{t.quick.more} →</a></p>
        </div>
      </section>

      <section id="faq" class="faq">
        <div class="wrap">
          <h2>{t.faq.title}</h2>
          {
            t.faq.items.map(([q, a], i) => (
              <details open={i === 0}>
                <summary>{q}</summary>
                <p set:html={a} />
              </details>
            ))
          }
        </div>
      </section>

      <section class="closing">
        <div class="wrap">
          <h2>{t.cta.title}</h2>
          <a class="btn primary" href={docsPath(lang)}>{t.cta.button}</a>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <div>
          <div class="brand">ippon<span class="dot">.</span></div>
          <p class="muted">{t.footer.tagline}</p>
        </div>
        <div class="foot-links">
          <a href={docsPath(lang)}>{t.footer.docs}</a>
          <a href="https://github.com/under18dev/ippon-slides">GitHub</a>
          <a href="https://www.npmjs.com/package/ippon-slides">npm</a>
          <a href={t.other.path}>{t.other.label}</a>
        </div>
      </div>
    </footer>

    <script>
      // コピー
      document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((b) => {
        b.addEventListener('click', () => {
          navigator.clipboard?.writeText(b.dataset.copy || '')
          const label = b.textContent
          b.textContent = b.dataset.done || label
          setTimeout(() => (b.textContent = label), 1200)
        })
      })

      // デモ：iframe のデッキ（同一オリジン）の #N を読み書きして、左の Markdown と連動させる
      const frame = document.getElementById('demo-frame') as HTMLIFrameElement | null
      const chunks = Array.from(document.querySelectorAll<HTMLButtonElement>('.chunks [data-slide]'))
      const list = document.querySelector<HTMLElement>('.chunks')
      const cur = document.querySelector<HTMLElement>('[data-cur]')
      if (frame && list && cur) {
        const total = chunks.length
        let shown = 0
        const current = () => {
          try {
            return Math.min(total, Math.max(1, parseInt(frame.contentWindow!.location.hash.slice(1), 10) || 1))
          } catch {
            return 1
          }
        }
        const go = (n: number) => {
          const loc = frame.contentWindow?.location
          if (!loc) return
          // hash への代入は親ページの履歴に積まれて「戻る」がスライドをたどってしまうので、置き換えで動かす
          // （相対の '#N' は親ページの URL で解決されるので、iframe の URL から組み立てる）
          loc.replace(loc.href.split('#')[0] + '#' + Math.min(total, Math.max(1, n)))
        }
        const sync = () => {
          const n = current()
          if (n === shown) return
          shown = n
          cur.textContent = String(n)
          chunks.forEach((c, i) => c.classList.toggle('on', i === n - 1))
          const el = chunks[n - 1]?.parentElement
          // ページ全体はスクロールさせず、Markdown の枠の中だけ動かす
          if (el) list.scrollTo({ top: el.offsetTop - list.offsetTop - 12, behavior: 'smooth' })
        }
        chunks.forEach((c, i) => c.addEventListener('click', () => go(i + 1)))
        document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
          b.addEventListener('click', () => go(current() + Number(b.dataset.step)))
        )
        frame.addEventListener('load', sync)
        // 枠が 960px より狭いときは、960px で描いたデッキを縮めて見せる
        const box = frame.parentElement!
        const fit = () => {
          const w = box.clientWidth
          const base = Math.max(w, 960)
          box.style.setProperty('--w', base + 'px')
          box.style.setProperty('--k', String(w / base))
        }
        new ResizeObserver(fit).observe(box)
        fit()
        setInterval(sync, 200)
      }
    </script>
  </body>
</html>
