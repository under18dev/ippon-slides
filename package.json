{
  "name": "ippon-slides",
  "version": "0.2.0",
  "description": "Markdown to one-message-per-slide decks (Takahashi method): one self-contained HTML file and a 16:9 PDF, zero dependencies. 1 枚 1 メッセージのスライドを Markdown から作る CLI",
  "keywords": [
    "slides",
    "slide-deck",
    "presentation",
    "presentation-tool",
    "markdown",
    "markdown-slides",
    "markdown-to-html",
    "markdown-to-pdf",
    "cli",
    "pdf",
    "takahashi-method",
    "speaker-notes",
    "presenter-view",
    "remote-control",
    "qr-code",
    "ogp",
    "zero-dependency",
    "single-file",
    "static-html",
    "スライド",
    "プレゼン"
  ],
  "license": "MIT",
  "author": "tanahiro2010",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/under18dev/ippon-slides.git"
  },
  "homepage": "https://ippon.under18.dev",
  "bugs": {
    "url": "https://github.com/under18dev/ippon-slides/issues"
  },
  "type": "module",
  "bin": {
    "ippon": "bin/ippon.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p src/client",
    "typecheck": "tsc && tsc -p src/client --noEmit",
    "test": "npm run build && node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
